nixos/local.nix
# Paperless import keeps its config and run state outside the repo
# (server: /etc/paperless-import, /var/lib/paperless-import; laptop:
# ~/.config/paperless-import, ~/.local/state/paperless-import). These only
# catch copies dropped here by mistake.
nixos/services/paperless-import/*.json
!nixos/services/paperless-import/config.example.json
nixos/services/paperless-import/*.jsonl
nixos/services/paperless-import/*.log
nixos/services/paperless-import/*.txt
nixos/services/paperless-import/__pycache__/
